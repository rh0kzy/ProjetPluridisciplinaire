import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import sys
import serial
from mpl_toolkits.mplot3d import Axes3D

try:
    import tkinter as tk
    from tkinter import ttk, filedialog, messagebox
except ModuleNotFoundError:
    print("Erreur : tkinter n'est pas installé. Veuillez l'installer avant d'exécuter ce programme.")
    sys.exit(1)

# 1. Fonction pour lire des fichiers de données texte
def lire_fichier():
    chemin_fichier = filedialog.askopenfilename(title="Sélectionner un fichier de données", filetypes=[("Fichiers texte", "*.txt"), ("Fichiers CSV", "*.csv")])
    if not chemin_fichier:
        return None
    try:
        rayons = pd.read_csv(chemin_fichier, delimiter=';', names=['rayon'])
        angles = np.arange(1, len(rayons) + 1)
        donnees = pd.DataFrame({'angle': angles, 'rayon': rayons['rayon']})

        entree_rayons.delete(0, tk.END)
        entree_rayons.insert(0, ','.join(map(str, rayons['rayon'].tolist())))
        entree_angles.delete(0, tk.END)
        entree_angles.insert(0, ','.join(map(str, angles.tolist())))

        return donnees
    except Exception as e:
        messagebox.showerror("Erreur", f"Impossible de lire le fichier : {e}")
        return None

# 2. Tracer en coordonnées polaires
def tracer_polaire(donnees, offset=0):
    angles = np.deg2rad(donnees['angle'])
    rayons = donnees['rayon'] - offset - 1

    fig, ax = plt.subplots(subplot_kw={'projection': 'polar'})
    ax.plot(angles, rayons, label="Données", color='red')  # Ligne rouge
    ax.scatter(angles, rayons, color='red')  # Points rouges
    ax.set_rorigin(-offset)
    ax.set_title("Graphique Polaire avec Offset")
    ax.legend()
    plt.show()

# 3. Tracer en coordonnées sphériques
def tracer_spherique(donnees, offset=0):
    fig = plt.figure()
    ax = fig.add_subplot(111, projection='3d')

    angles = np.deg2rad(donnees['angle'])
    rayons = donnees['rayon'] - offset
    x = rayons * np.cos(angles)
    y = rayons * np.sin(angles)
    z = np.linspace(0, max(rayons), len(rayons))

    ax.plot(x, y, z, label="Données en 3D", color='red')  # Ligne rouge
    ax.scatter(x, y, z, color='red')  # Points rouges
    ax.set_title("Graphique Sphérique")
    ax.legend()
    plt.show()

# 4. Collecter les données de l'utilisateur
def collecter_donnees():
    try:
        angles_str = entree_angles.get().strip()
        rayons_str = entree_rayons.get().strip()

        if not rayons_str:
            messagebox.showerror("Erreur", "Veuillez entrer au moins des valeurs pour les rayons.")
            return None

        rayons = list(map(float, rayons_str.split(',')))

        if angles_str:
            angles = list(map(float, angles_str.split(',')))
            if len(angles) != len(rayons):
                messagebox.showerror("Erreur", "Le nombre d'angles et de rayons doit être identique.")
                return None
        else:
            angles = list(range(1, len(rayons) + 1))
            messagebox.showinfo("Info", "Les angles ont été automatiquement générés de 1° à n°.")

        return pd.DataFrame({'angle': angles, 'rayon': rayons})
    except ValueError:
        messagebox.showerror("Erreur", "Veuillez entrer uniquement des nombres valides séparés par des virgules.")
        return None

# 5. Mettre à jour le graphique
def mettre_a_jour_graphique(mode="polaire"):
    donnees = collecter_donnees()
    if donnees is not None:
        try:
            offset = float(entree_offset.get())
        except ValueError:
            messagebox.showerror("Erreur", "Veuillez entrer une valeur numérique valide pour l'offset.")
            return

        max_offset = min(donnees['rayon'])
        if offset > max_offset:
            messagebox.showwarning("Avertissement", f"L'offset ne peut pas dépasser {max_offset}. Utilisation de 0 à la place.")
            offset = 0
        if mode == "polaire":
            tracer_polaire(donnees, offset)
        elif mode == "spherique":
            tracer_spherique(donnees, offset)

# 6. Lire depuis le port USB
def lire_port_usb():
    port = entree_port_usb.get()
    baudrate = 9600
    try:
        ser = serial.Serial(port, baudrate)
        messagebox.showinfo("USB", f"Connexion établie sur {port}")
        while True:
            ligne = ser.readline().decode('utf-8').strip()
            print(f"Données reçues : {ligne}")
    except Exception as e:
        messagebox.showerror("Erreur", f"Problème avec le port USB : {e}")
    finally:
        ser.close()

# Interface utilisateur
fenetre = tk.Tk()
fenetre.title("Visualisation des Données Polaires et Sphériques")

ttk.Button(fenetre, text="Charger un fichier", command=lire_fichier).grid(row=0, column=0, columnspan=2)

ttk.Label(fenetre, text="Angles (°) :").grid(row=1, column=0)
entree_angles = ttk.Entry(fenetre)
entree_angles.grid(row=1, column=1)

ttk.Label(fenetre, text="Rayons :").grid(row=2, column=0)
entree_rayons = ttk.Entry(fenetre)
entree_rayons.grid(row=2, column=1)

ttk.Label(fenetre, text="Offset :").grid(row=3, column=0)
entree_offset = ttk.Entry(fenetre)
entree_offset.grid(row=3, column=1)
entree_offset.insert(0, "0")

ttk.Label(fenetre, text="Port USB :").grid(row=4, column=0)
entree_port_usb = ttk.Entry(fenetre)
entree_port_usb.grid(row=4, column=1)
entree_port_usb.insert(0, "COM3")

ttk.Button(fenetre, text="Tracer en Polaire", command=lambda: mettre_a_jour_graphique("polaire")).grid(row=5, column=0, columnspan=2)
ttk.Button(fenetre, text="Tracer en Sphérique", command=lambda: mettre_a_jour_graphique("spherique")).grid(row=6, column=0, columnspan=2)
ttk.Button(fenetre, text="Lire depuis USB", command=lire_port_usb).grid(row=7, column=0, columnspan=2)

fenetre.mainloop()
