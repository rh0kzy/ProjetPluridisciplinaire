import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import sys
import serial
from mpl_toolkits.mplot3d import Axes3D

try:
    import tkinter as tk
    from tkinter import ttk, filedialog, messagebox
except ModuleNotFoundError:
    print("Erreur : tkinter n'est pas installé. Veuillez l'installer avant d'exécuter ce programme.")
    sys.exit(1)

# 1. Fonction pour lire des fichiers de données texte
def lire_fichier():
    chemin_fichier = filedialog.askopenfilename(title="Sélectionner un fichier de données", filetypes=[("Fichiers texte", "*.txt"), ("Fichiers CSV", "*.csv")])
    if not chemin_fichier:
        return None
    try:
        # Lire le fichier en supposant qu'il contient uniquement des rayons
        rayons = pd.read_csv(chemin_fichier, delimiter=';', names=['rayon'])
        
        # Générer des angles séquentiels (1, 2, 3, ...) en fonction du nombre de rayons
        angles = np.arange(1, len(rayons) + 1)  # Angles séquentiels : 1, 2, 3, ...
        
        # Créer un DataFrame avec les angles et les rayons
        donnees = pd.DataFrame({'angle': angles, 'rayon': rayons['rayon']})
        
        # Mettre à jour le champ des rayons avec les valeurs du fichier
        entree_rayons.delete(0, tk.END)  # Effacer le contenu actuel
        entree_rayons.insert(0, ','.join(map(str, rayons['rayon'].tolist())))  # Insérer les rayons
        
        # Mettre à jour le champ des angles avec les angles générés
        entree_angles.delete(0, tk.END)  # Effacer le contenu actuel
        entree_angles.insert(0, ','.join(map(str, angles.tolist())))  # Insérer les angles
        
        return donnees
    except Exception as e:
        messagebox.showerror("Erreur", f"Impossible de lire le fichier : {e}")
        return None

# 2. Fonction pour tracer les données en coordonnées polaires
def tracer_polaire(donnees):
    angles = np.deg2rad(donnees['angle'])
    rayons = donnees['rayon']

    fig, ax = plt.subplots(subplot_kw={'projection': 'polar'})
    ax.plot(angles, rayons, label="Données", color='red')  # Tracer en rouge
    ax.set_title("Graphique Polaire avec Rayons Négatifs")
    ax.legend()
    plt.show()

# 3. Fonction pour tracer en coordonnées sphériques
def tracer_spherique(donnees):
    fig = plt.figure()
    ax = fig.add_subplot(111, projection='3d')

    angles = np.deg2rad(donnees['angle'])
    rayons = donnees['rayon']
    x = rayons * np.cos(angles)
    y = rayons * np.sin(angles)
    z = np.linspace(0, len(rayons), len(rayons))

    ax.plot(x, y, z, label="Données en 3D", color='red')  # Tracer en rouge
    ax.set_title("Graphique Sphérique avec Rayons Négatifs")
    ax.legend()
    plt.show()

# 4. Fonction pour collecter les données de l'utilisateur
def collecter_donnees():
    try:
        angles_str = entree_angles.get().strip()
        rayons_str = entree_rayons.get().strip()
        
        if not rayons_str:
            messagebox.showerror("Erreur", "Veuillez entrer au moins des valeurs pour les rayons.")
            return None
        
        rayons = list(map(float, rayons_str.split(',')))
        nombre_de_valeurs = len(rayons)
        
        # Recalculer les angles en fonction de la formule (360 / nombre_de_valeurs)
        angles = [i * (360 / nombre_de_valeurs) for i in range(nombre_de_valeurs)]

        return pd.DataFrame({'angle': angles, 'rayon': rayons})
    except ValueError:
        messagebox.showerror("Erreur", "Veuillez entrer uniquement des nombres valides séparés par des virgules.")
        return None

# 5. Fonction pour mettre à jour le graphique
def mettre_a_jour_graphique(mode="polaire"):
    donnees = collecter_donnees()
    if donnees is not None:
        try:
            # Tracer le graphique en fonction du mode
            if mode == "polaire":
                tracer_polaire(donnees)
            elif mode == "spherique":
                tracer_spherique(donnees)
        except Exception as e:
            messagebox.showerror("Erreur", f"Erreur lors du tracé : {e}")
            
# 6. Fonction pour lire les données USB
def lire_port_usb():
    port = entree_port_usb.get()
    baudrate = 9600
    try:
        ser = serial.Serial(port, baudrate)
        messagebox.showinfo("USB", f"Connexion établie sur {port}")
        while True:
            ligne = ser.readline().decode('utf-8').strip()
            print(f"Données reçues : {ligne}")
    except Exception as e:
        messagebox.showerror("Erreur", f"Problème avec le port USB : {e}")
    finally:
        ser.close()

