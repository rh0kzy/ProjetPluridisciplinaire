# ========== THEME SETUP ==========
current_theme = 'light'

themes = {
    'light': {
        'bg': '#f0f0f0',
        'fg': '#000000',
        'entry_bg': '#ffffff',
        'button_bg': '#e0e0e0'
    },
    'dark': {
        'bg': '#2e2e2e',
        'fg': '#ffffff',
        'entry_bg': '#3c3f41',
        'button_bg': '#5c5c5c'
    }
}

def appliquer_theme(theme):
    fenetre.configure(bg=themes[theme]['bg'])
    for widget in fenetre.winfo_children():
        if isinstance(widget, (tk.Label, ttk.Label)):
            widget.configure(background=themes[theme]['bg'], foreground=themes[theme]['fg'])
        elif isinstance(widget, (tk.Entry, ttk.Entry)):
            widget.configure(background=themes[theme]['entry_bg'], foreground=themes[theme]['fg'])
        elif isinstance(widget, tk.Button):
            widget.configure(bg=themes[theme]['button_bg'], fg=themes[theme]['fg'], activebackground=themes[theme]['entry_bg'])
        elif isinstance(widget, ttk.Button):
            style = ttk.Style()
            style.configure('TButton', background=themes[theme]['button_bg'], foreground=themes[theme]['fg'])

def toggle_theme():
    global current_theme
    current_theme = 'dark' if current_theme == 'light' else 'light'
    appliquer_theme(current_theme)

