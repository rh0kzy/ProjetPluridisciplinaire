import tkinter as tk
from PIL import Image, ImageTk

# Créer la fenêtre principale
root = tk.Tk()
root.title("Fenêtre avec arrière-plan")

# Dimensions de la fenêtre
window_width = 1080
window_height = 720

# Obtenir les dimensions de l'écran
screen_width = root.winfo_screenwidth()
screen_height = root.winfo_screenheight()

# Calculer la position pour centrer la fenêtre
x = (screen_width // 2) - (window_width // 2)
y = (screen_height // 2) - (window_height // 2)

# Appliquer les dimensions et positionner la fenêtre
root.geometry(f"{window_width}x{window_height}+{x}+{y}")

# Empêcher le redimensionnement de la fenêtre
root.resizable(False, False)

# Charger l'image de fond
background_path = r"C:\Users\PC\Desktop\POO\ProjetPluridisciplinaire\back.jpg"
image = Image.open(background_path)
image = image.resize((window_width, window_height), Image.Resampling.LANCZOS)  # Remplacement de ANTIALIAS
background_image = ImageTk.PhotoImage(image)

# Ajouter l'image de fond à un label
background_label = tk.Label(root, image=background_image)
background_label.place(relwidth=1, relheight=1)

# Ajouter un label avec le texte
welcome_label = tk.Label(
    root,
    text="Bienvenue, veuillez choisir le type de votre tracage",
    font=("Montserrat", 25),
    bg="#ffffff"  # Couleur de fond blanche
)
welcome_label.place(x=69, y=119, width=942, height=43)

# Lancer la boucle principale
root.mainloop()