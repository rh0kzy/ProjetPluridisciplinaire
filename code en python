import tkinter as tk

def create_rounded_button(canvas, x, y, width, height, radius, text, command):
    canvas.create_arc(x, y, x + 2*radius, y + 2*radius, start=90, extent=90, fill="gray", outline="gray")
    canvas.create_arc(x + width - 2*radius, y, x + width, y + 2*radius, start=0, extent=90, fill="gray", outline="gray")
    canvas.create_arc(x, y + height - 2*radius, x + 2*radius, y + height, start=180, extent=90, fill="gray", outline="gray")
    canvas.create_arc(x + width - 2*radius, y + height - 2*radius, x + width, y + height, start=270, extent=90, fill="gray", outline="gray")
    canvas.create_rectangle(x + radius, y, x + width - radius, y + height, fill="gray", outline="gray")
    canvas.create_rectangle(x, y + radius, x + width, y + height - radius, fill="gray", outline="gray")
    
    button_text = canvas.create_text(x + width//2, y + height//2, text=text, fill="white", font=("Arial", 12))
    
    def on_click(event):
        command()
    
    canvas.tag_bind(button_text, "<Button-1>", on_click)

root = tk.Tk()
canvas = tk.Canvas(root, width=300, height=200)
canvas.pack()

create_rounded_button(canvas, 50, 50, 150, 50, 10, "Click Me", lambda: print("Button clicked!"))

root.mainloop()