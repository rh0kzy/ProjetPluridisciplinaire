import numpy as np
import matplotlib.pyplot as plt
from mpl_toolkits.mplot3d import Axes3D

# Création de la figure 3D
fig = plt.figure(figsize=(8, 6))
ax = fig.add_subplot(111, projection='3d')

# Générer une grille sphérique
phi = np.linspace(0, np.pi, 30)  # Latitude
theta = np.linspace(0, 2 * np.pi, 30)  # Longitude
phi, theta = np.meshgrid(phi, theta)

# Définir le rayon avec une variation
r = 1 + 0.2 * np.sin(3 * phi) * np.cos(5 * theta)

# Convertir en coordonnées cartésiennes
x = r * np.sin(phi) * np.cos(theta)
y = r * np.sin(phi) * np.sin(theta)
z = r * np.cos(phi)

# Tracer la surface avec une colormap
ax.plot_surface(x, y, z, cmap='jet', edgecolor='k', alpha=0.7)

# Ajouter des flèches (vecteurs)
ax.quiver(0, 0, 0, 1, 1, 1, color='black', arrow_length_ratio=0.1)
ax.quiver(0, 0, 0, -1, -1, 1, color='black', arrow_length_ratio=0.1)
ax.quiver(0, 0, 0, 1, -1, -1, color='black', arrow_length_ratio=0.1)

# Supprimer les axes pour un effet plus propre
ax.set_xticks([])
ax.set_yticks([])
ax.set_zticks([])

# Affichage
plt.show()
