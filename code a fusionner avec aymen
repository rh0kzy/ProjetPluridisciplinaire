import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import sys
import serial
from mpl_toolkits.mplot3d import Axes3D

try:
    import tkinter as tk
    from tkinter import ttk, filedialog, messagebox
except ModuleNotFoundError:
    print("Erreur : tkinter n'est pas installé. Veuillez l'installer avant d'exécuter ce programme.")
    sys.exit(1)

# 1. Fonction pour lire des fichiers de données texte
def lire_fichier():
    chemin_fichier = filedialog.askopenfilename(title="Sélectionner un fichier de données", filetypes=[("Fichiers texte", "*.txt"), ("Fichiers CSV", "*.csv")])
    if not chemin_fichier:
        return None
    try:
        rayons = pd.read_csv(chemin_fichier, delimiter=';', names=['rayon'])
        rayons['rayon'] = pd.to_numeric(rayons['rayon'], errors='coerce')
        if rayons['rayon'].isnull().any():
            raise ValueError("Le fichier contient des données non valides. Assurez-vous que tous les rayons sont des nombres réels.")
        angles = np.arange(1, len(rayons) + 1)
        donnees = pd.DataFrame({'angle': angles, 'rayon': rayons['rayon']})
        entree_rayons.delete(0, tk.END)
        entree_rayons.insert(0, ','.join(map(str, rayons['rayon'].tolist())))
        entree_angles.delete(0, tk.END)
        entree_angles.insert(0, ','.join(map(str, angles.tolist())))
        return donnees
    except Exception as e:
        messagebox.showerror("Erreur", f"Impossible de lire le fichier : {e}")
        return None

# 2. Fonction pour tracer les données en coordonnées polaires
def tracer_polaire(donnees, offset=0, echelle=1):
    print(f"[DEBUG] Tracer polaire avec échelle={echelle}, offset={offset}")
    angles = np.deg2rad(donnees['angle'])
    rayons = donnees['rayon'] * echelle
    fig, ax = plt.subplots(subplot_kw={'projection': 'polar'})
    ax.plot(angles, rayons, label=f"Données (Échelle={echelle})")
    ax.set_ylim(0, max(rayons) + offset)
    ax.set_rorigin(-offset)
    ax.set_title("Graphique Polaire avec Offset et Échelle")
    ax.legend()
    plt.show()

# 3. Fonction pour tracer en coordonnées sphériques
def tracer_spherique(donnees, echelle=1):
    print(f"[DEBUG] Tracer sphérique avec échelle={echelle}")
    angles = np.deg2rad(donnees['angle'])
    rayons = donnees['rayon'] * echelle
    x = rayons * np.cos(angles)
    y = rayons * np.sin(angles)
    z = np.linspace(0, max(rayons), len(rayons))
    fig = plt.figure()
    ax = fig.add_subplot(111, projection='3d')
    ax.plot(x, y, z, label=f"Données (Échelle={echelle})")
    ax.set_title("Graphique Sphérique")
    ax.legend()
    plt.show()

# 4. Fonction pour collecter les données de l'utilisateur
def collecter_donnees():
    try:
        angles_str = entree_angles.get().strip()
        rayons_str = entree_rayons.get().strip()
        if not rayons_str:
            messagebox.showerror("Erreur", "Veuillez entrer au moins des valeurs pour les rayons.")
            return None
        rayons = list(map(float, rayons_str.replace(',', '.').split(',')))
        if angles_str:
            angles = list(map(float, angles_str.replace(',', '.').split(',')))
            if len(angles) != len(rayons):
                messagebox.showerror("Erreur", "Le nombre d'angles et de rayons doit être identique.")
                return None
        else:
            angles = list(range(1, len(rayons) + 1))
            messagebox.showinfo("Info", "Les angles ont été automatiquement générés de 1° à n°.")
        return pd.DataFrame({'angle': angles, 'rayon': rayons})
    except ValueError:
        messagebox.showerror("Erreur", "Veuillez entrer uniquement des nombres valides (entiers ou réels) séparés par des virgules.")
        return None

# 5. Fonction pour mettre à jour le graphique
def mettre_a_jour_graphique(mode="polaire"):
    donnees = collecter_donnees()
    if donnees is not None:
        try:
            offset_str = entree_offset.get().replace(',', '.')
            echelle_str = entree_echelle.get().replace(',', '.')
            offset = float(offset_str)
            echelle = float(echelle_str)
            print(f"[DEBUG] Offset saisi: {offset}, Échelle saisie: {echelle}")
            if echelle <= 0:
                messagebox.showerror("Erreur", "L'échelle doit être un nombre positif.")
                return
            if mode == "polaire":
                tracer_polaire(donnees, offset, echelle)
            elif mode == "spherique":
                tracer_spherique(donnees, echelle)
        except ValueError:
            messagebox.showerror("Erreur", "Veuillez entrer des valeurs numériques valides pour l'offset et l'échelle.")

# 6. Fonction pour lire les données USB
def lire_port_usb():
    port = entree_port_usb.get()
    baudrate = 9600
    try:
        ser = serial.Serial(port, baudrate)
        messagebox.showinfo("USB", f"Connexion établie sur {port}")
        while True:
            ligne = ser.readline().decode('utf-8').strip()
            print(f"Données reçues : {ligne}")
    except Exception as e:
        messagebox.showerror("Erreur", f"Problème avec le port USB : {e}")
    finally:
        ser.close()

