import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import sys
import serial
from mpl_toolkits.mplot3d import Axes3D

try:
    import tkinter as tk
    from tkinter import ttk, filedialog, messagebox
except ModuleNotFoundError:
    print("Erreur : tkinter n'est pas installé. Veuillez l'installer avant d'exécuter ce programme.")
    sys.exit(1)

# 1. Fonction pour lire des fichiers de données texte
def lire_fichier():
    chemin_fichier = filedialog.askopenfilename(title="Sélectionner un fichier de données", filetypes=[("Fichiers texte", "*.txt"), ("Fichiers CSV", "*.csv")])
    if not chemin_fichier:
        return None
    try:
        return pd.read_csv(chemin_fichier, delimiter=';', names=['angle', 'rayon'])
    except Exception as e:
        messagebox.showerror("Erreur", f"Impossible de lire le fichier : {e}")
        return None

# 2. Fonction pour tracer les données en coordonnées polaires
def tracer_polaire(donnees, offset=0, echelle=1):
    angles = np.deg2rad(donnees['angle'])
    rayons = donnees['rayon'] * echelle

    fig, ax = plt.subplots(subplot_kw={'projection': 'polar'})
    ax.plot(angles, rayons, label="Données")
    ax.set_rorigin(-offset)
    ax.set_title("Graphique Polaire avec Offset et Échelle")
    ax.legend()
    plt.show()

# 3. Fonction pour tracer en coordonnées sphériques
def tracer_spherique(donnees, echelle=1):
    fig = plt.figure()
    ax = fig.add_subplot(111, projection='3d')

    angles = np.deg2rad(donnees['angle'])
    rayons = donnees['rayon'] * echelle
    x = rayons * np.cos(angles)
    y = rayons * np.sin(angles)
    z = np.linspace(0, max(rayons), len(rayons))

    ax.plot(x, y, z, label="Données en 3D")
    ax.set_title("Graphique Sphérique")
    ax.legend()
    plt.show()

# 4. Fonction pour collecter les données de l'utilisateur
def collecter_donnees():
    try:
        angles = list(map(float, entree_angles.get().split(',')))
        rayons = list(map(float, entree_rayons.get().split(',')))
        if len(angles) != len(rayons):
            messagebox.showerror("Erreur", "Le nombre d'angles et de rayons doit être identique.")
            return None
        return pd.DataFrame({'angle': angles, 'rayon': rayons})
    except ValueError:
        messagebox.showerror("Erreur", "Veuillez entrer des valeurs numériques valides.")
        return None

# 5. Fonction pour mettre à jour le graphique
def mettre_a_jour_graphique(mode="polaire"):
    donnees = collecter_donnees()
    if donnees is not None:
        offset = float(entree_offset.get())
        echelle = float(entree_echelle.get())
        if mode == "polaire":
            tracer_polaire(donnees, offset, echelle)
        elif mode == "spherique":
            tracer_spherique(donnees, echelle)

# 6. Fonction pour lire les données USB
def lire_port_usb():
    port = entree_port_usb.get()
    baudrate = 9600
    try:
        ser = serial.Serial(port, baudrate)
        messagebox.showinfo("USB", f"Connexion établie sur {port}")
        while True:
            ligne = ser.readline().decode('utf-8').strip()
            print(f"Données reçues : {ligne}")
    except Exception as e:
        messagebox.showerror("Erreur", f"Problème avec le port USB : {e}")
    finally:
        ser.close()

# Fonction pour centrer la fenêtre
def centrer_fenetre(fenetre):
    fenetre.update_idletasks()
    largeur_fenetre = fenetre.winfo_width()
    hauteur_fenetre = fenetre.winfo_height()
    largeur_ecran = fenetre.winfo_screenwidth()
    hauteur_ecran = fenetre.winfo_screenheight()
    position_x = (largeur_ecran // 2) - (largeur_fenetre // 2)
    position_y = (hauteur_ecran // 2) - (hauteur_fenetre // 2)
    fenetre.geometry(f"{largeur_fenetre}x{hauteur_fenetre}+{position_x}+{position_y}")

# Interface utilisateur
fenetre = tk.Tk()
fenetre.title("Visualisation des Données Polaires et Sphériques")

# Interdire le redimensionnement de la fenêtre
fenetre.resizable(False, False)

# Bouton pour charger un fichier
ttk.Button(fenetre, text="Charger un fichier", command=lire_fichier).grid(row=0, column=0, columnspan=2)

# Champs pour les angles
ttk.Label(fenetre, text="Angles (°) :").grid(row=1, column=0)
entree_angles = ttk.Entry(fenetre)
entree_angles.grid(row=1, column=1)

# Champs pour les rayons
ttk.Label(fenetre, text="Rayons :").grid(row=2, column=0)
entree_rayons = ttk.Entry(fenetre)
entree_rayons.grid(row=2, column=1)

# Champs pour l'offset
ttk.Label(fenetre, text="Offset :").grid(row=3, column=0)
entree_offset = ttk.Entry(fenetre)
entree_offset.grid(row=3, column=1)
entree_offset.insert(0, "0")

# Champs pour l'échelle
ttk.Label(fenetre, text="Échelle :").grid(row=4, column=0)
entree_echelle = ttk.Entry(fenetre)
entree_echelle.grid(row=4, column=1)
entree_echelle.insert(0, "1")

# Champs pour le port USB
ttk.Label(fenetre, text="Port USB :").grid(row=5, column=0)
entree_port_usb = ttk.Entry(fenetre)
entree_port_usb.grid(row=5, column=1)
entree_port_usb.insert(0, "COM3")

# Bouton pour afficher le graphique polaire
ttk.Button(fenetre, text="Tracer en Polaire", command=lambda: mettre_a_jour_graphique("polaire")).grid(row=6, column=0, columnspan=2)

# Bouton pour afficher le graphique sphérique
ttk.Button(fenetre, text="Tracer en Sphérique", command=lambda: mettre_a_jour_graphique("spherique")).grid(row=7, column=0, columnspan=2)

# Bouton pour lire depuis USB
ttk.Button(fenetre, text="Lire depuis USB", command=lire_port_usb).grid(row=8, column=0, columnspan=2)

# Lancer l'interface
centrer_fenetre(fenetre)
fenetre.mainloop()
